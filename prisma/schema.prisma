generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model visitor {
  visitorID   Int       @id @default(autoincrement())
  clientID    Int?
  visitorUUID String    @unique @db.VarChar(255)
  latitude    Float?    
  longitude   Float?    
  city        String?   @db.VarChar(100)
  region      String?   @db.VarChar(100)
  country     String?   @db.VarChar(100)
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  firstVisit  DateTime  @default(now())
  lastVisit   DateTime  @default(now())
  isActive    Boolean   @default(true)
  
  // Relations
  client     client?    @relation(fields: [clientID], references: [clientID], onDelete: Cascade)
  sessions   session[]  // Changed from activities to sessions
  
  @@map("visitor")
}

model session {
  sessionID   Int      @id @default(autoincrement())
  visitorID   Int
  pageUrl     String?  @db.Text
  pageTitle   String?  @db.VarChar(255)
  dateVisited DateTime @default(now()) @db.DateTime(0)
  dateLeft    DateTime? @db.DateTime(0)
  duration    Int?     // Duration in seconds
  metadata    String?  @db.Text // Store additional data as JSON
  
  // Relations
  visitor visitor @relation(fields: [visitorID], references: [visitorID], onDelete: Cascade)
  
  @@map("session")
}

model client {
  clientID      Int           @id @default(autoincrement())
  clientName    String?       @db.VarChar(100)
  email         String        @unique(map: "email") @db.VarChar(50)
  contactNumber String?       @db.VarChar(20)
  address       String?       @db.VarChar(255)
  timeAvailFrom DateTime?     @db.Time(0)
  timeAvailTo   DateTime?     @db.Time(0)
  password      String        @db.VarChar(255)
  adsAgree      Boolean
  emailVerified Boolean       @default(false)
  dateCreated   DateTime      @default(now()) @map("dateCreated")
  
  // Relations
  carts         cart[]
  feedbacks     feedback[]
  transactions  transaction[]
  vouchers      voucher[]
  visitors      visitor[]
  
  @@map("client")
}

model cart {
  cartID       Int           @id @default(autoincrement())
  clientID     Int
  productID    Int
  quantity     Int
  subtotal     Float         @db.Float
  logo         String        @default("Default") @db.VarChar(100)
  status       String        @db.VarChar(100)
  dateAdded    DateTime      @default(now()) @map("dateAdded")
  client       client        @relation(fields: [clientID], references: [clientID])
  product      products      @relation(fields: [productID], references: [productID])
  transactions transaction[]

  @@index([clientID], map: "cart_clientID_fkey")
  @@index([productID], map: "cart_productID_fkey")
}

model tracking {
  trackingID Int      @id @default(autoincrement())
  status     String   @db.VarChar(100)
  info       String?  @db.VarChar(100)
  time       DateTime? @db.Time(0)
  date       DateTime @default(now())
  
  // Relations
  transactions transaction[]
  
  @@map("tracking")
}

model transaction {
  orderID       Int      @id @default(autoincrement())
  transactionID String   @db.VarChar(255)  // Remove unique constraint here
  cartID        Int      // Remove unique constraint - allow multiple transactions per cart
  billingID     Int?
  voucherID     Int?
  trackingID    Int
  clientID      Int
  shipMethod    String   @db.VarChar(100)
  subtotal      Float    @db.Float
  dateOrdered   DateTime @default(now()) @map("dateOrdered")
  
  // Relations
  billing       billing?  @relation(fields: [billingID], references: [billingID])
  cart          cart      @relation(fields: [cartID], references: [cartID])
  tracking      tracking  @relation(fields: [trackingID], references: [trackingID])
  client        client    @relation(fields: [clientID], references: [clientID])
  voucher       voucher?  @relation(fields: [voucherID], references: [voucherID])

  @@index([billingID], map: "transaction_billingID_fkey")
  @@index([cartID], map: "transaction_cartID_fkey")
  @@index([trackingID], map: "transaction_trackingID_fkey")
  @@index([voucherID], map: "transaction_voucherID_fkey")
  @@index([clientID], map: "transaction_clientID_fkey")
  @@unique([transactionID, cartID]) // Add composite unique constraint instead
}

model Otp {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(6)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp")
}

model voucher {
  voucherID    Int           @id @default(autoincrement())
  voucherLabel String        @db.VarChar(255)
  discount     Int
  clientID     Int
  isUsed       Boolean
  dateAdded    DateTime      @default(now()) @map("dateAdded")
  expiration   DateTime      @db.DateTime(0)
  transactions transaction[]
  client       client        @relation(fields: [clientID], references: [clientID])

  @@index([clientID], map: "voucher_clientID_fkey")
}

model billing {
  billingID    Int           @id @default(autoincrement())
  mode         String        @db.VarChar(255)
  referenceNo  String        @unique(map: "referenceNo") @db.VarChar(100)
  sender       String        @db.VarChar(100)
  receiver     String        @db.VarChar(100)
  amount       Float         @db.Float
  dateAdded    DateTime      @db.DateTime(0)
  transactions transaction[]
}

model feedback {
  feedbackID Int      @id @default(autoincrement())
  clientID   Int
  productID  Int
  rate       Float    @db.Float
  comment    String?  @db.Text
  dateAdded  DateTime @default(now()) @map("dateAdded")
  client     client   @relation(fields: [clientID], references: [clientID])
  product    products @relation(fields: [productID], references: [productID])

  @@index([clientID], map: "feedback_clientID_fkey")
  @@index([productID], map: "feedback_productID_fkey")
}

model products {
  productID        Int        @id @default(autoincrement())
  name             String     @db.VarChar(255)
  price            Float      @db.Float
  description      String     @db.Text
  frontUrl         String?    @db.Text
  backUrl          String?    @db.Text
  imgUrl           String?    @db.Text
  dateAdded        DateTime   @default(now()) @map("dateAdded")
  category         String     @default("Business Cards") @db.VarChar(100)
  customPrice      Float?     @db.Float
  variableBackImg  String?    @db.Text
  variableFrontImg String?    @db.Text
  carts            cart[]
  feedbacks        feedback[]
}

model admin {
  adminID    Int      @id @default(autoincrement())
  authLevel  Int
  email      String   @unique
  password   String
  status     String
  dateCreated DateTime @default(now())

  @@map("admin")
}